# apps/web environment — copy to .env.local and fill in.
# The website is hosted separately from the SST Lambda workers, so these are
# its own env vars (not SST secrets).

# --- Client-safe (public by design; bundled into the browser) ---

# --- Server-only (never bundled to the browser; read via process.env
WALLET_ADDRESS=

# X10 (Extended) read-only REST calls, authenticated with the API key header.
EXTENDED_API_KEY=

# --- Better-auth ---
# Secret used to sign session cookies / JWTs — 32+ chars, e.g.:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public base URL of the app (dev: http://localhost:3000)
BETTER_AUTH_URL=http://localhost:3000
# Postgres connection string. For Supabase use the SESSION pooler URL
# (Dashboard → Connect → Session pooler, port 5432) — prepared statements
# require session mode. Example:
#   postgresql://postgres.lapkwtulywsjfjogngcx:[db-password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=
