# apps/web environment — copy to .env.local and fill in.
# The website is hosted separately from the SST Lambda workers, so these are
# its own env vars (not SST secrets).

# --- Client-safe (public by design; bundled into the browser) ---
# Supabase project URL + anon key. The anon key is safe client-side as long
# as row-level security (RLS) restricts the `exchange` / `ticker` tables to
# what you're happy making public.
VITE_SUPABASE_URL=https://lapkwtulywsjfjogngcx.supabase.co
VITE_SUPABASE_ANON_KEY=

# --- Server-only (never bundled to the browser; read via process.env
# inside src/server/* server functions) ---
# Hyperliquid uses the public Info API — the wallet address is on-chain
# public data, no private key needed.
HYPERLIQUID_WALLET=

# X10 (Extended) read-only REST calls, authenticated with the API key header.
EXTENDED_API_KEY=
# Optional override; defaults to https://api.starknet.extended.exchange
# EXTENDED_API=

# RiseX positions are read with the public InfoClient; only the account
# address is needed. Falls back to HYPERLIQUID_WALLET if unset.
# RISEX_WALLET=
